// Verification Tool initial schema (TASK-004).
// Production target: PostgreSQL. Local task does not require a real DB.
// Sensitive fields are stored as hashes or encrypted blobs — never plaintext.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserRole {
  OWNER
  ADMIN
  STAFF_READ_ONLY
}

enum CustomerStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum MailboxProvider {
  MICROSOFT
  MOCK
}

enum MailboxStatus {
  ACTIVE
  RECONNECT_REQUIRED
  SUBSCRIPTION_EXPIRED
  WEBHOOK_FAILED
  DISABLED
  ERROR
}

enum TelegramMappingStatus {
  ACTIVE
  DISABLED
}

enum GraphSubscriptionStatus {
  ACTIVE
  EXPIRED
  FAILED
  RENEWING
}

enum ProcessedMessageStatus {
  DETECTED
  SENT
  FAILED
  SKIPPED_LOW_CONFIDENCE
  DUPLICATE
}

// -----------------------------------------------------------------------------
// Models
// -----------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  role         UserRole @default(STAFF_READ_ONLY)
  passwordHash String?
  authProvider String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdMailboxes            Mailbox[]             @relation("MailboxCreatedBy")
  createdTelegramMappings     TelegramMapping[]     @relation("TelegramMappingCreatedBy")
  createdTelegramDestinations TelegramDestination[] @relation("TelegramDestinationCreatedBy")
  auditLogs                   AuditLog[]

  // TASK-045 — internal staff ownership. A STAFF_READ_ONLY user only sees the
  // customers (and their mailboxes) assigned to them here. OWNER/ADMIN ignore
  // this relation entirely and see everything.
  staffAssignments    StaffAssignment[] @relation("StaffAssignmentUser")
  assignmentsRecorded StaffAssignment[] @relation("StaffAssignmentAssignedBy")
}

model Customer {
  id        String         @id @default(cuid())
  name      String
  status    CustomerStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  mailboxes        Mailbox[]
  // TASK-045 — staff assigned to operate this customer (and its mailboxes).
  staffAssignments StaffAssignment[]
  // TASK-053 — reusable Telegram destinations are scoped to a customer so a
  // mailbox can only ever be mapped to its own customer's group/topic.
  telegramDestinations TelegramDestination[]
}

model Mailbox {
  id                    String          @id @default(cuid())
  emailAddress          String          @unique
  provider              MailboxProvider
  ownerCustomerName     String?
  customerId            String?
  customer              Customer?       @relation(fields: [customerId], references: [id])
  status                MailboxStatus   @default(ACTIVE)
  microsoftUserId       String?
  // OAuth refresh token MUST be encrypted before write. Encryption helper
  // arrives in TASK-020; this column never holds plaintext.
  encryptedRefreshToken String?
  tokenLastRefreshedAt  DateTime?
  lastSuccessfulSyncAt  DateTime?
  // TASK-031 — backup delta polling. `microsoftDeltaCursor` stores the FULL
  // @odata.deltaLink URL returned by Microsoft Graph (opaque to us). We never
  // parse $deltatoken / $skiptoken out of it.
  microsoftDeltaCursor  String?
  deltaLastPolledAt     DateTime?
  deltaLastErrorAt      DateTime?
  deltaLastErrorMessage String?
  createdById           String?
  createdBy             User?           @relation("MailboxCreatedBy", fields: [createdById], references: [id])
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  telegramMappings   TelegramMapping[]
  graphSubscriptions GraphSubscription[]
  processedMessages  ProcessedMessage[]

  @@index([customerId])
  @@index([status])
}

model TelegramMapping {
  id                String                @id @default(cuid())
  mailboxId         String
  mailbox           Mailbox               @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  telegramChatId    String
  telegramGroupName String?
  // TASK-041 — optional Telegram forum topic routing. When set, the sender
  // passes `message_thread_id` so the code lands in a specific topic inside the
  // group. `telegramThreadId` is the numeric topic/thread id; `telegramTopicName`
  // is a human label only. Both are optional so plain group routing is unchanged.
  // Many mailboxes may share the same telegramChatId (+ telegramThreadId): there
  // is deliberately NO unique constraint on those columns.
  telegramThreadId  String?
  telegramTopicName String?
  status            TelegramMappingStatus @default(ACTIVE)
  // TASK-053 — optional link to a reusable TelegramDestination. Additive and
  // nullable: legacy mappings created before TASK-053 keep `destinationId = null`
  // and route from their own snapshot columns above. When a mapping IS linked,
  // the resolve pipeline reads the live destination (and skips sending when the
  // destination is DISABLED). The chat/group/thread/topic columns are still
  // written as a snapshot so the @@unique below and the existing UI keep working.
  destinationId     String?
  destination       TelegramDestination?  @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  createdById       String?
  createdBy         User?                 @relation("TelegramMappingCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  // Keeps a single mailbox from holding duplicate rows to the SAME chat. It does
  // NOT (and must not) prevent different mailboxes from sharing a chat id — that
  // is the whole point of TASK-041.
  //
  // TASK-068A — "at most one ACTIVE mapping per mailbox" is now ALSO enforced at
  // the DB level by a PARTIAL unique index on (mailboxId) WHERE status = 'ACTIVE'.
  // Prisma's schema language cannot express a partial (filtered) unique index, so
  // it lives in the raw migration
  // `20260604000000_task068a_one_active_telegram_mapping` and is intentionally
  // absent here. DISABLED mappings stay unconstrained, so "many mailboxes share
  // one reusable destination" is unaffected. Note for maintainers: a future
  // `prisma migrate dev` may report this index as drift because the schema does
  // not declare it — keep it; do not let an auto-generated migration drop it.
  @@unique([mailboxId, telegramChatId])
  // Speeds up "how many mailboxes route to this destination" lookups for the UI.
  @@index([telegramChatId])
  @@index([status])
  @@index([destinationId])
}

// TASK-053 — Reusable Telegram destination.
//
// A destination is a saved Telegram group (or a forum topic inside a group) that
// Admin/Owner configure ONCE and then reuse when mapping mailboxes. It is scoped
// to a Customer so a mailbox can only ever be mapped to its own customer's
// destinations (cross-customer isolation is enforced in the service layer).
//
// Many mailboxes may share one destination (TASK-041 routing rule is preserved):
// there is deliberately NO unique constraint tying a destination to a single
// mailbox. "No duplicate destination within a customer for the same chat/thread"
// is enforced in the service layer (Postgres treats NULL thread ids as distinct,
// so a DB unique cannot cover the plain-group case reliably).
//
// SECURITY: only chat/thread IDs and human labels are stored here — never a bot
// token (tokens live in env, see docs/SECURITY_RULES.md §3).
model TelegramDestination {
  id                String                @id @default(cuid())
  customerId        String
  customer          Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // Operator-facing label so a destination is easy to recognise in dropdowns.
  displayName       String
  telegramGroupName String
  telegramTopicName String?
  telegramChatId    String
  telegramThreadId  String?
  status            TelegramMappingStatus @default(ACTIVE)
  createdById       String?
  createdBy         User?                 @relation("TelegramDestinationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  mappings TelegramMapping[]

  @@index([customerId])
  @@index([status])
}

model GraphSubscription {
  id                 String                  @id @default(cuid())
  mailboxId          String
  mailbox            Mailbox                 @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  subscriptionId     String                  @unique
  resource           String
  // Microsoft Graph clientState MUST NOT be persisted in plaintext — we only
  // compare hashes on webhook receipt.
  clientStateHash    String
  expirationDateTime DateTime
  status             GraphSubscriptionStatus @default(ACTIVE)
  lastRenewedAt      DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([mailboxId])
  @@index([status])
}

model ProcessedMessage {
  id                String                 @id @default(cuid())
  mailboxId         String
  mailbox           Mailbox                @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  graphMessageId    String
  internetMessageId String?
  receivedAt        DateTime
  senderEmail       String
  subjectHash       String?
  // Verification code is NEVER stored in plaintext. codeHash is used for
  // dedup/audit only and cannot recover the original code.
  codeHash          String?
  status            ProcessedMessageStatus @default(DETECTED)
  sentToTelegramAt  DateTime?
  createdAt         DateTime               @default(now())

  @@unique([mailboxId, graphMessageId])
  @@index([receivedAt])
  @@index([status])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  actorUser    User?    @relation(fields: [actorUserId], references: [id])
  actorEmail   String?
  // TASK-040: stored as String so the (wider) application-level action set
  // (customer/telegram/admin-login/system events) is not constrained by a
  // narrow DB enum. Values are still validated in the service layer.
  action       String
  entityType   String
  entityId     String?
  severity     String   @default("info")
  summary      String?
  // Sensitive keys (token/secret/password/code/...) are scrubbed by the
  // service before this column is written.
  metadataJson Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// TASK-040: Code event log persisted to the DB so the Web UI (Next process) and
// the email worker (separate process) read/write the SAME store. The full
// verification code, email body, and any token/secret are NEVER stored here —
// only a masked/hashed code reference and safe metadata.
model CodeEvent {
  id                String    @id @default(cuid())
  createdAt         DateTime  @default(now())
  receivedAt        DateTime?
  mailboxEmail      String
  customerName      String?
  platform          String    @default("Facebook/Meta")
  status            String
  // Masked/hashed code only (e.g. "82****" or "sha256:<hex>"). Never raw.
  maskedCode        String?
  confidence        Int?
  telegramGroupName String?
  source            String    @default("mock")
  message           String?

  @@index([createdAt])
  @@index([status])
  @@index([mailboxEmail])
}

// TASK-045 — Internal staff ownership / assignment model.
//
// Join table linking a STAFF_READ_ONLY user to the customers they are allowed
// to see and operate. Scope is customer-level on purpose: a mailbox inherits
// its scope from `Mailbox.customerId`, so assigning a customer automatically
// grants visibility to that customer's mailboxes (and their Telegram mappings).
//
// OWNER and ADMIN are NOT constrained by this table — the service layer treats
// them as "see everything". This table only ever narrows STAFF visibility.
//
// `assignedById` records which OWNER/ADMIN created the assignment (nullable so
// a deleted actor does not cascade-delete the assignment). It holds NO secrets.
model StaffAssignment {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("StaffAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedById String?
  assignedBy   User?    @relation("StaffAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  // A staff user is assigned a given customer at most once.
  @@unique([userId, customerId])
  @@index([userId])
  @@index([customerId])
}
