# Verification Tool environment variables (example only — do NOT put real secrets here)
#
# Copy this file to `.env.local` for local development.
# Never commit a real `.env` file.

# Runtime
APP_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Database (filled in TASK-004)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Microsoft OAuth (filled in Sprint 5)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/microsoft/oauth/callback

# Telegram (filled in Sprint 2)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ALERT_CHAT_ID=

# Encryption key for stored OAuth tokens (filled in Sprint 5 / TASK-020)
ENCRYPTION_KEY=
