# Verification Tool environment variables (example only — do NOT put real secrets here)
#
# Copy this file to `.env.local` for local development.
# Never commit a real `.env` file.

# Runtime
APP_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Database (filled in TASK-004)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Microsoft OAuth (filled in Sprint 5)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/microsoft/oauth/callback

# Microsoft Graph subscription (filled in Sprint 6 / TASK-023)
# Public HTTPS URL Microsoft Graph posts notifications to. Required to create
# inbox subscriptions. The webhook endpoint itself ships in TASK-024.
MICROSOFT_GRAPH_NOTIFICATION_URL=
# Optional lifecycle notification URL. Microsoft Graph posts subscription
# lifecycle events (reauthorizationRequired/missed) here. Leave empty until
# the lifecycle endpoint exists.
MICROSOFT_GRAPH_LIFECYCLE_NOTIFICATION_URL=

# Telegram (filled in Sprint 2)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ALERT_CHAT_ID=

# Encryption key for stored OAuth tokens (filled in Sprint 5 / TASK-020)
# Must be a base64 string that decodes to exactly 32 bytes (AES-256-GCM).
# Generate locally with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=nalEIVJZXcG9Ew6PQbF/QzIlSu60kDrNs4EJd1zrMiA=

# Dev-only flag (TASK-006). When set to "true" AND APP_ENV=development,
# getCurrentUser() returns a demo OWNER user so the /admin area is reachable
# before real auth (Microsoft OAuth) lands. Ignored in production.
AUTH_DEV_DEMO_USER=

# Queue / Redis (filled in TASK-026)
# Connection URL used by BullMQ. Leave default for local dev.
REDIS_URL=redis://127.0.0.1:6379
# BullMQ queue name. Falls back to "email-processing" if unset.
EMAIL_QUEUE_NAME=email-processing
# Worker concurrency (positive integer). Falls back to 2 if unset or invalid.
EMAIL_WORKER_CONCURRENCY=2

# Delta polling backup worker (TASK-031). The webhook receiver remains the
# primary path; this worker polls Microsoft Graph delta as a backup so missed
# webhook notifications still get processed.
# Master switch. Set to "false" to disable the scheduler. Defaults to true.
DELTA_POLLING_ENABLED=true
# Polling interval in seconds. Floors to 5s; defaults to 30s.
DELTA_POLLING_INTERVAL_SECONDS=30
# Per-mailbox safety cap on @odata.nextLink pagination, prevents infinite
# loops if Graph keeps returning pages. Defaults to 10.
DELTA_POLLING_MAX_PAGES_PER_MAILBOX=10

# Subscription renewal worker (TASK-032). Renews Microsoft Graph subscriptions
# before they expire so webhook delivery never lapses. No secrets here.
# Master switch. Set to "false" to disable the scheduler. Defaults to true.
SUBSCRIPTION_RENEWAL_ENABLED=true
# How often the renewal scheduler runs, in seconds. Floors to 60s; defaults to
# 900s (15 minutes).
SUBSCRIPTION_RENEWAL_INTERVAL_SECONDS=900
# Renew a subscription when it has this many hours (or fewer) left before it
# expires. Floors to 1h; defaults to 24h.
SUBSCRIPTION_RENEWAL_WINDOW_HOURS=24
