# =============================================================================
# Verification Code Relay Tool — PRODUCTION env EXAMPLE (placeholders only)
# =============================================================================
# This file is committed. It MUST contain placeholders only — never real
# secrets, tokens, client secrets, or production connection strings.
#
# Do NOT create a real `.env.production` with secrets inside this folder.
# Real production values live ONLY in the deploy platform's secret manager
# (Railway / Render / etc.) or an injected env that is gitignored and never
# committed.
#
# See ./README.md and ../../docs/STAGING_DEPLOYMENT.md for the full setup guide.
# Every production resource below MUST be separate from staging/local.
# =============================================================================

# --- Runtime ---------------------------------------------------------------
APP_ENV=production
APP_URL=https://YOUR_PRODUCTION_DOMAIN
LOG_LEVEL=info

# --- Database (production only — never point at staging/local) -------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# --- Queue / Redis (production only — never point at staging/local) --------
REDIS_URL=redis://USER:PASSWORD@HOST:PORT
EMAIL_QUEUE_NAME=email-processing
EMAIL_WORKER_CONCURRENCY=2

# --- Encryption key for stored OAuth tokens (AES-256-GCM) ------------------
# SENSITIVE — leave this blank in the committed example. Set the real value
# ONLY in the deploy platform's secret manager; never commit it to the repo.
# Must be a base64 string that decodes to exactly 32 bytes.
# Generate a FRESH key for production (do NOT reuse local/dev/staging):
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Microsoft OAuth / Graph ----------------------------------------------
# Use a SEPARATE production App Registration. Do not reuse staging/local secrets.
MICROSOFT_CLIENT_ID=replace_with_production_client_id
# SENSITIVE — leave blank here. Configure the real client secret ONLY in the
# deploy platform's secret manager; never commit it to the repo.
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
# Must match the Redirect URI registered in the production App Registration EXACTLY.
MICROSOFT_REDIRECT_URI=https://YOUR_PRODUCTION_DOMAIN/api/microsoft/oauth/callback

# --- Microsoft Graph subscription (webhook) --------------------------------
# Public HTTPS URL Microsoft Graph posts mail notifications to.
# Actual app route is /api/webhooks/microsoft/mail.
MICROSOFT_GRAPH_NOTIFICATION_URL=https://YOUR_PRODUCTION_DOMAIN/api/webhooks/microsoft/mail
# Optional lifecycle notification URL. Leave empty unless a lifecycle endpoint exists.
MICROSOFT_GRAPH_LIFECYCLE_NOTIFICATION_URL=

# --- Telegram (production bot + real customer destinations) ----------------
# SENSITIVE — leave the bot token blank here. It lives ONLY in the deploy
# platform secret manager, never in the DB and never committed to the repo.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ALERT_CHAT_ID=replace_with_production_admin_alert_chat_id

# --- Admin sign-in (production is FAIL-CLOSED — TASK-057) ------------------
# There is no real production sign-in provider yet, so production admin access
# is locked by design. The dev/staging-only variables below DO NOT grant
# production access and are ignored when APP_ENV=production. Do NOT set them
# here to try to open production — that path is intentionally closed.
#   AUTH_DEV_DEMO_USER          -> development only
#   STAGING_ADMIN_PASSWORD      -> staging only
#   STAGING_ADMIN_SESSION_SECRET-> staging only
# A real production sign-in provider + its variables land in a later task.

# --- Delta polling backup worker -------------------------------------------
DELTA_POLLING_ENABLED=true
DELTA_POLLING_INTERVAL_SECONDS=30
DELTA_POLLING_MAX_PAGES_PER_MAILBOX=10
# First-run lookback window (hours) — bounds the initial sync of a new mailbox.
DELTA_POLLING_BOOTSTRAP_LOOKBACK_HOURS=24

# --- Subscription renewal worker -------------------------------------------
SUBSCRIPTION_RENEWAL_ENABLED=true
SUBSCRIPTION_RENEWAL_INTERVAL_SECONDS=900
SUBSCRIPTION_RENEWAL_WINDOW_HOURS=24
