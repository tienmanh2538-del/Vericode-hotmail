# =============================================================================
# Verification Code Relay Tool — STAGING env EXAMPLE (placeholders only)
# =============================================================================
# This file is committed. It MUST contain placeholders only — never real
# secrets, tokens, client secrets, or production connection strings.
#
# Do NOT create a real `.env.staging` with secrets inside this folder.
# Real staging values live ONLY in the deploy platform's secret manager
# (Vercel / Railway / Render / Fly / etc.) or an injected `.env` that is
# gitignored and never committed.
#
# See ../../docs/STAGING_DEPLOYMENT.md for the full setup guide.
# =============================================================================

# --- Runtime ---------------------------------------------------------------
APP_ENV=staging
APP_URL=https://YOUR_STAGING_DOMAIN
LOG_LEVEL=info

# --- Database (staging only — never point at production) -------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# --- Queue / Redis ---------------------------------------------------------
REDIS_URL=redis://USER:PASSWORD@HOST:PORT
EMAIL_QUEUE_NAME=email-processing
EMAIL_WORKER_CONCURRENCY=2

# --- Encryption key for stored OAuth tokens (AES-256-GCM) ------------------
# SENSITIVE — leave this blank in the committed example. Set the real value
# ONLY in the deploy platform's secret manager; never commit it to the repo.
# Must be a base64 string that decodes to exactly 32 bytes.
# Generate a fresh key for staging (do NOT reuse the local/dev key):
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Microsoft OAuth / Graph ----------------------------------------------
# Use a SEPARATE App Registration for staging. Do not reuse local dev secrets.
MICROSOFT_CLIENT_ID=replace_with_staging_client_id
# SENSITIVE — leave blank here. Configure the real client secret ONLY in the
# deploy platform's secret manager; never commit it to the repo.
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
# Must match the Redirect URI registered in the staging App Registration EXACTLY.
MICROSOFT_REDIRECT_URI=https://YOUR_STAGING_DOMAIN/api/microsoft/oauth/callback

# --- Microsoft Graph subscription (webhook) --------------------------------
# Public HTTPS URL Microsoft Graph posts mail notifications to.
# Actual app route is /api/webhooks/microsoft/mail.
MICROSOFT_GRAPH_NOTIFICATION_URL=https://YOUR_STAGING_DOMAIN/api/webhooks/microsoft/mail
# Optional lifecycle notification URL. Leave empty unless a lifecycle endpoint exists.
MICROSOFT_GRAPH_LIFECYCLE_NOTIFICATION_URL=

# --- Telegram (staging test group only — never a real customer group) ------
# SENSITIVE — leave the bot token blank here. It lives ONLY in the deploy
# platform secret manager, never in the DB and never committed to the repo.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ALERT_CHAT_ID=replace_with_staging_admin_alert_chat_id

# --- Auth dev flag ---------------------------------------------------------
# Dev-only demo user. Ignored when APP_ENV is not "development". Keep empty.
AUTH_DEV_DEMO_USER=

# --- Staging admin login (TASK-040 preflight) ------------------------------
# SENSITIVE — leave blank in the committed example. Set a strong passphrase in
# the deploy platform secret manager so /admin is reachable on staging without
# opening it to the public. Empty ⇒ staging admin stays locked (fail-closed).
STAGING_ADMIN_PASSWORD=
# Optional dedicated HMAC secret for the staging session cookie. Falls back to
# ENCRYPTION_KEY when unset. SENSITIVE — set only in the secret manager.
STAGING_ADMIN_SESSION_SECRET=

# --- Delta polling backup worker -------------------------------------------
DELTA_POLLING_ENABLED=true
DELTA_POLLING_INTERVAL_SECONDS=30
DELTA_POLLING_MAX_PAGES_PER_MAILBOX=10

# --- Subscription renewal worker -------------------------------------------
SUBSCRIPTION_RENEWAL_ENABLED=true
SUBSCRIPTION_RENEWAL_INTERVAL_SECONDS=900
SUBSCRIPTION_RENEWAL_WINDOW_HOURS=24
